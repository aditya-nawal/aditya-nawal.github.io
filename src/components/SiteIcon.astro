---
interface Props {
  name: 'scholar' | 'linkedin' | 'email' | 'microsoft';
}

const { name } = Astro.props;
---

<svg class={`site-icon site-icon--${name}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'scholar' && (
    <>
      <path d="M12 3 1.8 8.1 12 13.2l8-4v5.2h2V8.1L12 3Z" />
      <path d="M5.2 11.1v5.2c0 1.7 3 3.7 6.8 3.7s6.8-2 6.8-3.7v-5.2L12 14.5l-6.8-3.4Z" />
    </>
  )}
  {name === 'linkedin' && (
    <>
      <path d="M5.2 7.7H1.5V22h3.7V7.7ZM3.4 1A2.2 2.2 0 1 0 3.4 5.4 2.2 2.2 0 0 0 3.4 1Z" />
      <path d="M22.5 13.8c0-4.3-2.3-6.4-5.4-6.4-2.5 0-3.6 1.4-4.2 2.3v-2H9.2V22h3.7v-7.1c0-1.9.4-3.8 2.8-3.8 2.4 0 2.4 2.2 2.4 3.9v7h3.7l.7-8.2Z" />
    </>
  )}
  {name === 'email' && (
    <path d="M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm9 9L3.4 6.2v11.4h17.2V6.2L12 13Zm0-2.6L20.2 6H3.8L12 10.4Z" />
  )}
  {name === 'microsoft' && (
    <>
      <path fill="#f25022" d="M2 2h9v9H2z" />
      <path fill="#7fba00" d="M13 2h9v9h-9z" />
      <path fill="#00a4ef" d="M2 13h9v9H2z" />
      <path fill="#ffb900" d="M13 13h9v9h-9z" />
    </>
  )}
</svg>
