---
interface Props {
  name: 'scholar' | 'github' | 'linkedin' | 'email' | 'university' | 'microsoft' | 'globe' | 'degree';
}

const { name } = Astro.props;
---

<svg class={`site-icon site-icon--${name}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'scholar' && (
    <>
      <path d="M12 3 1.8 8.1 12 13.2l8-4v5.2h2V8.1L12 3Z" />
      <path d="M5.2 11.1v5.2c0 1.7 3 3.7 6.8 3.7s6.8-2 6.8-3.7v-5.2L12 14.5l-6.8-3.4Z" />
    </>
  )}
  {name === 'github' && (
    <path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.2.8-.6v-2.2c-3.4.7-4.1-1.4-4.1-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.3.1 2 1.3 2 1.3 1.1 2 3 1.4 3.7 1.1.1-.8.4-1.4.7-1.7-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11.2 11.2 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.4 11.4 0 0 0 12 .8Z" />
  )}
  {name === 'linkedin' && (
    <>
      <path d="M5.2 7.7H1.5V22h3.7V7.7ZM3.4 1A2.2 2.2 0 1 0 3.4 5.4 2.2 2.2 0 0 0 3.4 1Z" />
      <path d="M22.5 13.8c0-4.3-2.3-6.4-5.4-6.4-2.5 0-3.6 1.4-4.2 2.3v-2H9.2V22h3.7v-7.1c0-1.9.4-3.8 2.8-3.8 2.4 0 2.4 2.2 2.4 3.9v7h3.7l.7-8.2Z" />
    </>
  )}
  {name === 'email' && (
    <path d="M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm9 9L3.4 6.2v11.4h17.2V6.2L12 13Zm0-2.6L20.2 6H3.8L12 10.4Z" />
  )}
  {name === 'university' && (
    <>
      <path d="M12 2 2 7v2h20V7L12 2Zm-6 9v7H3v3h18v-3h-3v-7h-3v7h-2v-7h-2v7H9v-7H6Z" />
    </>
  )}
  {name === 'microsoft' && (
    <>
      <path fill="#f25022" d="M2 2h9v9H2z" />
      <path fill="#7fba00" d="M13 2h9v9h-9z" />
      <path fill="#00a4ef" d="M2 13h9v9H2z" />
      <path fill="#ffb900" d="M13 13h9v9h-9z" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M2.8 12h18.4M12 2.5c2.7 2.6 4.1 5.8 4.1 9.5s-1.4 6.9-4.1 9.5C9.3 18.9 7.9 15.7 7.9 12S9.3 5.1 12 2.5Z" fill="none" stroke="currentColor" stroke-width="1.8" />
    </>
  )}
  {name === 'degree' && (
    <>
      <path d="m12 3-10 5 10 5 8-4v6h2V8L12 3Z" />
      <path d="M5 11v6c1.8 2.1 4.2 3.1 7 3.1s5.2-1 7-3.1v-6l-7 3.5L5 11Z" />
    </>
  )}
</svg>
