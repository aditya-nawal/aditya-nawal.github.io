  {name === 'linkedin' && (
    <>
      <path d="M5.2 7.7H1.5V22h3.7V7.7ZM3.4 1A2.2 2.2 0 1 0 3.4 5.4 2.2 2.2 0 0 0 3.4 1Z" />
      <path d="M22.5 13.8c0-4.3-2.3-6.4-5.4-6.4-2.5 0-3.6 1.4-4.2 2.3v-2H9.2V22h3.7v-7.1c0-1.9.4-3.8 2.8-3.8 2.4 0 2.4 2.2 2.4 3.9v7h3.7l.7-8.2Z" />
    </>
  )}
  {name === 'email' && (
    <path d="M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm9 9L3.4 6.2v11.4h17.2V6.2L12 13Zm0-2.6L20.2 6H3.8L12 10.4Z" />
  )}
  {name === 'orcid' && (
    <>
      <circle cx="12" cy="12" r="11" fill="#a6ce39" />
      <circle cx="8.1" cy="7.2" r="1.35" fill="#fff" />
      <path d="M6.9 10h2.4v7.3H6.9zM11 6.4h4c3.5 0 5.7 2.1 5.7 5.4 0 3.4-2.2 5.5-5.7 5.5h-4V6.4Zm2.4 2.2v6.5h1.4c2.1 0 3.4-1.2 3.4-3.3 0-2-1.3-3.2-3.4-3.2h-1.4Z" fill="#fff" />
    </>
  )}
  {name === 'openreview' && (
    <>
      <path d="M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7l-5 4v-4H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M6.5 7.3h11M6.5 10.4h8.2M6.5 13.5h5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
    </>
  )}
  {name === 'dblp' && (
    <>
      <rect x="2" y="4" width="20" height="16" rx="3" fill="#3569a8" />
