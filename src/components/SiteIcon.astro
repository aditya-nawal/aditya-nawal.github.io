const { name } = Astro.props;
---

<svg class={`site-icon site-icon--${name}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'scholar' && (
    <>
      <path d="M12 3 1.8 8.1 12 13.2l8-4v5.2h2V8.1L12 3Z" />
      <path d="M5.2 11.1v5.2c0 1.7 3 3.7 6.8 3.7s6.8-2 6.8-3.7v-5.2L12 14.5l-6.8-3.4Z" />
    </>
  )}
  {name === 'github' && (
    <path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.2.8-.6v-2.2c-3.4.7-4.1-1.4-4.1-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.3.1 2 1.3 2 1.3 1.1 2 3 1.4 3.7 1.1.1-.8.4-1.4.7-1.7-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11.2 11.2 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.4 11.4 0 0 0 12 .8Z" />
