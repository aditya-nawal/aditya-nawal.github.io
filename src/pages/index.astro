---
import Layout from '../layouts/Layout.astro';
import SiteIcon from '../components/SiteIcon.astro';
---

<Layout>
  <main class="academic-site">
    <header class="nature-header" aria-labelledby="profile-name">
      <nav class="nature-nav" aria-label="Primary navigation">
        <div class="nature-nav__inner">
          <div class="nature-nav__links">
            <a href="#about">About</a>
            <a href="#career">Career</a>
            <a href="#publications">Publications</a>
            <a href="#contact">Contact</a>
            <a href="/cv.pdf" target="_blank" rel="noreferrer">CV</a>
          </div>
        </div>
      </nav>

      <div class="nature-header__content" id="top">
        <p class="nature-header__eyebrow">Language-model agents · AI safety · security</p>
        <h1 id="profile-name">Aditya Nawal</h1>
        <blockquote>Lord is causelessly merciful and we are causelessly rebellious</blockquote>
      </div>
    </header>

    <div class="academic-shell">
      <section class="profile-intro" aria-label="Introduction">
        <img class="profile-photo" src="/images/profile.jpg" alt="Aditya Nawal" width="200" height="200" />
        <div class="profile-copy">
          <p class="profile-role">PhD Student · National University of Singapore</p>
          <div class="profile-links" aria-label="Professional profiles">
            <a href="https://scholar.google.com/citations?user=jUBC5FwAAAAJ&hl=en" target="_blank" rel="noreferrer" aria-label="Google Scholar" title="Google Scholar"><SiteIcon name="scholar" /></a>
            <a href="https://github.com/aditya-nawal" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub"><SiteIcon name="github" /></a>
            <a href="https://www.linkedin.com/in/aditya-nawal-7a841719b/" target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn"><SiteIcon name="linkedin" /></a>
            <a href="https://orcid.org/0009-0008-5700-7146" target="_blank" rel="noreferrer" aria-label="ORCID" title="ORCID"><SiteIcon name="orcid" /></a>
            <a href="https://openreview.net/profile?id=~Aditya_Nawal1" target="_blank" rel="noreferrer" aria-label="OpenReview" title="OpenReview"><SiteIcon name="openreview" /></a>
            <a href="https://dblp.org/pid/392/1622" target="_blank" rel="noreferrer" aria-label="DBLP" title="DBLP"><SiteIcon name="dblp" /></a>
            <a href="https://www.semanticscholar.org/author/2290774418" target="_blank" rel="noreferrer" aria-label="Semantic Scholar" title="Semantic Scholar"><SiteIcon name="semantic-scholar" /></a>
            <a href="mailto:adityanawal@u.nus.edu" aria-label="Email Aditya Nawal" title="adityanawal@u.nus.edu"><SiteIcon name="email" /></a>
          </div>
        </div>
      </section>

      <section class="academic-section about-section" id="about">
        <h2>About</h2>
        <div class="about-copy">
          <p>I am a PhD student in Electrical and Computer Engineering at NUS. My research examines the safety and security of language-model agents, particularly how retrieval and tool use alter model behaviour and how these effects transfer across languages.</p>
          <p>Before starting my PhD, I was a Software Development Engineer at Microsoft, where I built Azure OpenAI-assisted reasoning workflows and production tooling for cloud network diagnosis.</p>
        </div>
      </section>

      <section class="academic-section career-section" id="career">
        <div class="section-heading-row career-heading">
          <h2>Career Summary</h2>
          <span>Research · Engineering · Education</span>
        </div>

        <div class="career-timeline">
          <article class="career-entry career-entry--right">
            <div class="career-symbol career-symbol--nus"><SiteIcon name="university" /></div>
            <span class="career-marker" aria-hidden="true"></span>
            <div class="career-card">
              <time datetime="2025-01">Jan 2025 — Present</time>
              <h3>National University of Singapore</h3>
              <p>PhD Student · Electrical and Computer Engineering</p>
            </div>
          </article>

          <article class="career-entry career-entry--left">
            <div class="career-card">
              <time datetime="2022-07">Jul 2022 — Dec 2024</time>
              <h3>Microsoft</h3>
              <p>Software Development Engineer</p>
            </div>
            <span class="career-marker" aria-hidden="true"></span>
            <div class="career-symbol career-symbol--microsoft"><SiteIcon name="microsoft" /></div>
          </article>

          <article class="career-entry career-entry--right">
            <div class="career-symbol career-symbol--microsoft"><SiteIcon name="microsoft" /></div>
            <span class="career-marker" aria-hidden="true"></span>
            <div class="career-card">
              <time datetime="2022-01">Jan 2022 — Jun 2022</time>
              <h3>Microsoft</h3>
              <p>Software Development Intern</p>
            </div>
          </article>

          <article class="career-entry career-entry--left">
            <div class="career-card">
              <time datetime="2021-05">May 2021 — Jul 2021</time>
              <h3>Akamai Technologies</h3>
              <p>Software Development Intern</p>
            </div>
            <span class="career-marker" aria-hidden="true"></span>
            <div class="career-symbol career-symbol--akamai"><SiteIcon name="globe" /></div>
          </article>

          <article class="career-entry career-entry--right">
            <div class="career-symbol career-symbol--bits"><SiteIcon name="degree" /></div>
            <span class="career-marker" aria-hidden="true"></span>
            <div class="career-card">
              <time datetime="2018-08">Aug 2018 — Jun 2022</time>
              <h3>BITS Pilani</h3>
              <p>B.E. Electronics and Electrical Engineering</p>
            </div>
          </article>
        </div>
      </section>

      <section class="academic-section publications-section" id="publications">
        <div class="section-heading-row publication-heading">
          <div>
            <h2>Selected Publications</h2>
            <p>Figures shown below are taken directly from the corresponding papers.</p>
          </div>
          <a class="all-publications-link" href="https://scholar.google.com/citations?user=jUBC5FwAAAAJ&hl=en" target="_blank" rel="noreferrer">Google Scholar ↗</a>
        </div>

        <div class="academic-publications">
          <article class="academic-publication">
            <figure class="academic-publication__figure">
              <a href="https://arxiv.org/abs/2605.29224" target="_blank" rel="noreferrer">
                <img src="/images/retrieval-safety.png" alt="Paper teaser showing web retrieval changing an LLM agent's safety behaviour" />
              </a>
              <figcaption>Paper teaser</figcaption>
            </figure>
            <div class="academic-publication__info">
              <h3><a href="https://arxiv.org/abs/2605.29224" target="_blank" rel="noreferrer">Relevance as a Vulnerability: How Web Retrieval Degrades Safety Alignment in LLM Agents</a></h3>
              <p class="academic-publication__authors"><strong>Aditya Nawal</strong>, Manit Baser, Mohan Gurusamy</p>
              <p class="academic-publication__summary">We study how incorporating web retrieval can weaken safety alignment in language-model agents.</p>
              <div class="academic-publication__actions">
                <span class="venue-badge">ARXIV 2026</span>
                <a class="publication-button" href="https://arxiv.org/pdf/2605.29224" target="_blank" rel="noreferrer">PDF</a>
                <a class="publication-button" href="https://arxiv.org/abs/2605.29224" target="_blank" rel="noreferrer">Paper Page</a>
              </div>
            </div>
          </article>

          <article class="academic-publication">
            <figure class="academic-publication__figure">
              <a href="https://dl.acm.org/doi/10.1145/3689641" target="_blank" rel="noreferrer">
                <img src="/images/generative-ai-figure-1.png" alt="Figure 1 comparing VAE, GAN, transformer, autoregressive, and diffusion architectures" />
              </a>
              <figcaption>Exact paper figure · Figure 1</figcaption>
            </figure>
            <div class="academic-publication__info">
              <h3><a href="https://dl.acm.org/doi/10.1145/3689641" target="_blank" rel="noreferrer">Revolutionizing Visuals: The Role of Generative AI in Modern Image Generation</a></h3>
              <p class="academic-publication__authors">Gaurang Bansal, <strong>Aditya Nawal</strong>, Vinay Chamola, Norbert Herencsar</p>
              <p class="academic-publication__summary">A comprehensive study of modern generative image systems, their capabilities, limitations, and deployment trade-offs.</p>
              <div class="academic-publication__actions">
                <span class="venue-badge">ACM TOMM 2024</span>
                <a class="publication-button" href="https://dspace.vut.cz/bitstreams/d59c3f08-5ffc-4930-ac2c-c7df569cfcf9/download" target="_blank" rel="noreferrer">PDF</a>
                <a class="publication-button" href="https://dl.acm.org/doi/10.1145/3689641" target="_blank" rel="noreferrer">Publisher</a>
              </div>
            </div>
          </article>

          <article class="academic-publication">
            <figure class="academic-publication__figure">
              <a href="https://ieeexplore.ieee.org/document/10461070/" target="_blank" rel="noreferrer">
                <img src="/images/iomt-figure-1.png" alt="Figure 1 showing the proposed IoMT incremental-learning methodology" />
              </a>
              <figcaption>Exact paper figure · Figure 1</figcaption>
            </figure>
            <div class="academic-publication__info">
              <h3><a href="https://ieeexplore.ieee.org/document/10461070/" target="_blank" rel="noreferrer">An IoMT-based Incremental Learning Framework with a Novel Feature Selection Algorithm for Intelligent Diagnosis in Smart Healthcare</a></h3>
              <p class="academic-publication__authors">Siva Sai, Kartikey Singh Bhandari, <strong>Aditya Nawal</strong>, Vinay Chamola, Biplab Sikdar</p>
              <p class="academic-publication__summary">An edge-enabled incremental-learning framework for accurate and efficient diagnosis in smart healthcare.</p>
              <div class="academic-publication__actions">
                <span class="venue-badge">IEEE TMLCN 2024</span>
                <a class="publication-button" href="https://www.ece.nus.edu.sg/stfpage/bsikdar/papers/tmlcn_healthcare_24.pdf" target="_blank" rel="noreferrer">PDF</a>
                <a class="publication-button" href="https://ieeexplore.ieee.org/document/10461070/" target="_blank" rel="noreferrer">Publisher</a>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="academic-section contact-section-compact" id="contact">
        <h2>Contact</h2>
        <div>
          <p>I welcome conversations about language-model agents, retrieval security, multilingual AI safety, and research collaborations.</p>
          <a class="email-link" href="mailto:adityanawal@u.nus.edu"><SiteIcon name="email" /> <span>adityanawal@u.nus.edu</span></a>
        </div>
      </section>

      <footer class="academic-footer">
        <span>© 2026 Aditya Nawal</span>
        <span>Design informed by <a href="https://github.com/msaveski/www_personal" target="_blank" rel="noreferrer">Martin Saveski</a> and <a href="https://github.com/myyzzzoooo/myyzzzoooo.github.io" target="_blank" rel="noreferrer">Hoiyeong Jin</a>.</span>
      </footer>
    </div>
  </main>
</Layout>
